#!/usr/bin/env python3
"""sentinel-check — Sentinel v0, the fleet's read-only watch (fleet-v1 §3). Runs as svc-hermes on a timer.

No model: every check is a fixed threshold from sentinel.yaml. It reads hosts only through the fleet's
forced-command key (fleet-status JSON), probes public endpoints over HTTPS, and posts to #infra-alerts
as Elmaati — only when a problem appears, escalates or clears. `--digest` posts the daily summary (the
dead-man signal: no digest by 08:15 means the watch itself is down). `--dry-run` prints instead of posting.

Source of truth: core/elmaati/deploy/hq/sentinel/ (installed root-owned by install.sh).
"""
import datetime
import json
import os
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request
import zoneinfo
from concurrent.futures import ThreadPoolExecutor

import yaml

CONF = "/usr/local/lib/sentinel/sentinel.yaml"
STATE = os.path.expanduser("~/.local/state/sentinel/state.json")
KEY = os.path.expanduser("~/.ssh/fleet_ed25519")
ENV = os.path.expanduser("~/.hermes/.env")
UA = "corecuity-sentinel (v0; +https://corecuity.com)"
TZ = zoneinfo.ZoneInfo("Africa/Casablanca")   # founders read times in Moroccan time, not the server's CEST

CRIT, WARN = "🔴", "🟠"
# Order and headings of the groups in a message.
GROUPS = [("down", "Sites down"), ("tls", "Certificates"), ("backup", "Backups"),
          ("host", "Servers"), ("expiry", "Expiring credentials")]


def problem(sev, group, subject, detail):
    return {"sev": sev, "group": group, "subject": subject, "detail": detail}


def why(e):
    """A network error in plain words, not a Python traceback."""
    if isinstance(e, ConnectionRefusedError):
        return "connection refused (nothing listening on 443)"
    if isinstance(e, (TimeoutError, socket.timeout)):
        return "no answer (timed out)"
    if isinstance(e, socket.gaierror):
        return "DNS lookup failed"
    if isinstance(e, urllib.error.URLError) and getattr(e, "reason", None):
        return why(e.reason) if isinstance(e.reason, Exception) else str(e.reason)
    return f"{e.__class__.__name__}: {str(e)[:60]}"


def fleet_status(addr):
    p = subprocess.run(["ssh", "-T", "-n", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-i", KEY,
                        f"fleetwatch@{addr}"], capture_output=True, text=True, timeout=60)
    return json.loads(p.stdout)


def check_host(name, spec, th, ignore, now):
    found, info = {}, []
    try:
        d = fleet_status(spec["addr"])
    except Exception as e:
        found[f"{name}:unreachable"] = problem(CRIT, "host", name, f"can't read its status ({why(e)}) — the watch is blind here")
        return found, info
    for disk in d["disks"]:
        pct, mnt = disk["used_pct"], disk["mount"]
        if pct >= th["disk_warn_pct"]:
            sev = CRIT if pct >= th["disk_crit_pct"] else WARN
            found[f"{name}:disk:{mnt}"] = problem(sev, "host", name, f"disk `{mnt}` is {pct}% full")
    m = d["memory_kb"]
    avail = 100 * m["MemAvailable"] / m["MemTotal"]
    if avail < th["mem_available_min_pct"]:
        found[f"{name}:memory"] = problem(WARN, "host", name, f"only {avail:.0f}% memory free")
    for unit in d["services"]["failed_system_units"]:
        if unit not in ignore:
            found[f"{name}:failed:{unit}"] = problem(CRIT, "host", name, f"service `{unit}` has failed")
    units = {u["unit"]: u for u in d.get("backup_units", [])}
    found.update(judge_backups(name, name, units, spec.get("backups", []), th, now))
    tenant = d.get("tenant_backups")
    if spec.get("tenant_backups"):
        if not isinstance(tenant, dict) or "units" not in tenant:
            why_not = "the tenant-backup helper isn't installed" if tenant is None else tenant.get("error", "bad data")
            found[f"{name}:tenant-backups"] = problem(CRIT, "backup", f"client backups on {name}",
                                                      f"can't be read ({why_not}) — the watch is blind to them")
        else:
            for user, expected in spec["tenant_backups"].items():
                mine = {u["unit"]: u for u in tenant["units"] if u["user"] == user}
                found.update(judge_backups(name, f"{name}/{user}", mine, expected, th, now))
            watched = set(spec["tenant_backups"])
            unwatched = [u for u in tenant.get("lingering_users", []) if u not in watched]
            local_only = [u for u, exp in spec["tenant_backups"].items() if not any("offsite" in x for x in exp)]
            if local_only:
                info.append(f"**{name}** — backed up locally only (no off-site copy): {', '.join(local_only)}")
            if unwatched:
                info.append(f"**{name}** — tenants with no backup watched: {', '.join(unwatched)}")
    parts = []
    if d["host"]["reboot_required"]:
        parts.append("reboot pending")
    if d["apt"]["upgradable"]:
        parts.append(f"{d['apt']['upgradable']} updates waiting")
    info.append(f"**{name}** — " + (" · ".join(parts) if parts else "up to date"))
    return found, info


def judge_backups(host, scope, units, expected, th, now):
    """Judge the expected backup units of one scope (a host's system units, or one tenant's user units).
    Off-site copies are chained after the local backup, so while any backup in the scope is running,
    the others may be queued behind it: their age says nothing until the chain finishes."""
    found = {}
    chain_running = any(u.get("active") in ("activating", "active", "reloading") for u in units.values())
    for unit in expected:
        label = unit.removesuffix(".service")
        key = f"{scope}:backup:{unit}"
        u = units.get(unit)
        if not u:
            found[key] = problem(CRIT, "backup", label, f"not found on {host}")
            continue
        if u["result"] != "success":
            found[key] = problem(CRIT, "backup", label, f"last run failed on {host} (exit {u['exit_status']})")
            continue
        if u.get("active") in ("activating", "active", "reloading"):
            # Running right now: systemd has reset the exit time to 0, so judge by how long it has run.
            st = u.get("started") or ""
            run_h = (now - int(st.lstrip("@"))) / 3600 if st.startswith("@") and st != "@0" else 0
            if run_h > th["backup_max_run_h"]:
                found[key] = problem(WARN, "backup", label, f"still running after {run_h:.0f} h on {host}")
            continue
        if chain_running:
            continue
        fin = u.get("finished") or ""
        age_h = (now - int(fin.lstrip("@"))) / 3600 if fin.startswith("@") and fin != "@0" else None
        if age_h is None or age_h > th["backup_max_age_h"]:
            when = "has never run" if age_h is None else f"last succeeded {age_h:.0f} h ago"
            found[key] = problem(CRIT, "backup", label, f"{when} on {host} (limit {th['backup_max_age_h']} h)")
    return found


def check_endpoint(entry, th, now):
    host, _, path = entry.partition("/")   # "api.example.com/api" checks that path; default is "/"
    found = {}
    try:
        ctx = ssl.create_default_context()
        with socket.create_connection((host, 443), timeout=10) as s, ctx.wrap_socket(s, server_hostname=host) as t:
            not_after = ssl.cert_time_to_seconds(t.getpeercert()["notAfter"])
        days = (not_after - now) / 86400
        if days < th["tls_warn_days"]:
            sev = CRIT if days < th["tls_crit_days"] else WARN
            found[f"tls:{host}"] = problem(sev, "tls", host, f"certificate expires in {days:.0f} days")
    except ssl.SSLCertVerificationError as e:
        found[f"tls:{host}"] = problem(CRIT, "tls", host, f"certificate invalid ({e.verify_message})")
        return found
    except Exception as e:
        found[f"up:{host}"] = problem(CRIT, "down", host, why(e))
        return found

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *a, **k):
            return None
    req = urllib.request.Request(f"https://{host}/{path}", headers={"User-Agent": UA})
    try:
        code = urllib.request.build_opener(NoRedirect).open(req, timeout=20).status
    except urllib.error.HTTPError as e:
        code = e.code
    except Exception as e:
        found[f"up:{host}"] = problem(CRIT, "down", host, why(e))
        return found
    if code >= 400 and code not in (401, 403):   # an auth wall still means the service is up
        found[f"up:{host}"] = problem(CRIT, "down", f"{host}/{path}".rstrip("/"), f"answers HTTP {code}")
    return found


def check_expiries(items, now):
    found = {}
    today = datetime.date.fromtimestamp(now)
    for it in items:
        days = (it["date"] - today).days
        date = it["date"].strftime("%-d %b")
        if days < 0:
            found[f"expiry:{it['name']}"] = problem(CRIT, "expiry", it["name"], f"**expired** on {date} → {it['action']}")
        elif days <= 14:
            step = next(s for s in (1, 3, 7, 14) if days <= s)   # re-alerts as it crosses 7, 3, 1
            sev = CRIT if days <= 3 else WARN
            found[f"expiry:{it['name']}:{step}"] = problem(sev, "expiry", it["name"],
                                                           f"expires **{date}** (in {days} days) → {it['action']}")
    return found


def render(problems):
    """Problems grouped under headings, worst first within each group."""
    out = []
    for group, heading in GROUPS:
        rows = sorted((p for p in problems if p["group"] == group), key=lambda p: (p["sev"] != CRIT, p["subject"]))
        if rows:
            out += ([""] if out else []) + [f"**{heading}**"]
            out += [f"{p['sev']} **{p['subject']}** — {p['detail']}" for p in rows]
    return out


def counts(problems):
    c = sum(p["sev"] == CRIT for p in problems)
    w = len(problems) - c
    return " · ".join(x for x in (f"{c} critical" if c else "", f"{w} warning{'s' * (w != 1)}" if w else "") if x)


def post(text, channel, dry):
    if dry:
        print("--- would post ---\n" + text + "\n")
        return
    token = next(l.split("=", 1)[1].strip().strip("\"'") for l in open(ENV) if l.startswith("DISCORD_BOT_TOKEN="))
    for chunk in [text[i:i + 1900] for i in range(0, len(text), 1900)]:
        req = urllib.request.Request(f"https://discord.com/api/v10/channels/{channel}/messages", method="POST",
                                     data=json.dumps({"content": chunk, "allowed_mentions": {"parse": []}}).encode(),
                                     headers={"Authorization": f"Bot {token}", "Content-Type": "application/json",
                                              "User-Agent": UA})
        urllib.request.urlopen(req, timeout=20).read()


def main():
    dry, digest = "--dry-run" in sys.argv, "--digest" in sys.argv
    conf = yaml.safe_load(open(CONF))
    th, now = conf["thresholds"], time.time()
    found, info = {}, []
    ignore = set(conf.get("ignore_failed_units", []))
    with ThreadPoolExecutor(max_workers=12) as pool:   # dead hosts wait out timeouts in parallel, not in series
        hosts = [pool.submit(check_host, n, spec, th, ignore, now) for n, spec in conf["hosts"].items()]
        sites = [pool.submit(check_endpoint, e, th, now) for e in conf["endpoints"]]
        for fut in hosts:
            f, i = fut.result()
            found.update(f)
            info += i
        for fut in sites:
            found.update(fut.result())
    found.update(check_expiries(conf.get("expiries", []), now))

    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    try:
        prev = json.load(open(STATE))
    except (OSError, ValueError):
        prev = {}
    prev = {k: (v if isinstance(v, dict) else {"sev": v[:1], "subject": k.split(":", 1)[-1]}) for k, v in prev.items()}
    # New = a problem not seen last run, or one whose severity changed. Wording that drifts (ages, days)
    # must not re-alert every 15 minutes.
    new = [p for k, p in found.items() if k not in prev or prev[k]["sev"] != p["sev"]]
    cleared = [p for k, p in prev.items() if k not in found]
    targets = len(conf["hosts"]) + len(conf["endpoints"]) + len(conf.get("expiries", [])) + \
        sum(len(u) for spec in conf["hosts"].values() for u in (spec.get("tenant_backups") or {}).values())
    stamp = datetime.datetime.fromtimestamp(now, TZ).strftime("%H:%M")

    if digest:
        day = datetime.datetime.fromtimestamp(now, TZ).strftime("%a %-d %b")
        head = f"## 🛰️ Sentinel · daily check · {day}"
        status = f"✅ **All clear** — {targets} targets watched" if not found else \
                 f"**{len(found)} open** ({counts(found.values())}) · {targets} targets watched"
        lines = [head, status, ""] + render(found.values()) + ["", "**Servers**"] + [f"▫️ {i}" for i in info] + \
                ["", "-# Not watched yet: the Désirs box, MajorMedia."]
        post("\n".join(lines), conf["discord_channel"], dry)
    elif new or cleared:
        parts = []
        if new:
            parts.append(f"**{len(new)} new** ({counts(new)})")
        if cleared:
            parts.append(f"**{len(cleared)} resolved**")
        lines = [f"🛰️ **Sentinel** · " + " · ".join(parts)]
        if new:
            lines += [""] + render(new)
        if cleared:
            lines += ["", "**Resolved**"] + [f"✅ **{p['subject']}** — back to normal" for p in cleared]
        lines += ["", f"-# {stamp} · {len(found)} open in total · checks every 15 min"]
        post("\n".join(lines), conf["discord_channel"], dry)
    elif dry:
        print(f"no change — {len(found)} open, {targets} targets")
    if not dry:
        json.dump(found, open(STATE, "w"), indent=1, ensure_ascii=False)   # after the post, so a failed post retries


if __name__ == "__main__":
    main()
