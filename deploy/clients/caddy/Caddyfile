# --- Plane PM (rootless, added 2026-05-16) ---
plane.corecuity.com {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    reverse_proxy localhost:8082
}

status.corecuity.com {
	# same credentials as monitor.corecuity.com (admin / <existing password>)
	import auth_netdata
	# read-only Netdata data API for the custom dashboard
	handle /api/* {
		reverse_proxy localhost:19999
	}
	# the custom status dashboard (static page); NOT the agent's React UI
	handle {
		root * /var/www/corecuity-status
		file_server
	}
}

