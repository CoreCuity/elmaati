# --- Désirs d'Orient — REHEARSAL copy of production (neutralised), added 2026-10-09 ---
# Temporary: remove this block and the desirs.corecuity.com DNS record when the rehearsal copy is wiped
# (clients/desirs/relocation/RUNBOOK.md phase 3.5).
desirs.corecuity.com {
    # The Odoo database manager answers even with list_db = False; never expose it.
    @dbmgr path /web/database/*
    respond @dbmgr 403
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Frame-Options "SAMEORIGIN"
        ?X-Content-Type-Options "nosniff"
    }
    reverse_proxy 127.0.0.1:8101
}

