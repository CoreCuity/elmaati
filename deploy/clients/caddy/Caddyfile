# --- You&Co (tenant youandco, added 2026-08-24) ---------------------------
# Laravel app built by Technopek. Backend is rootless Docker on 127.0.0.1:8100
# (nginx -> php-fpm -> mysql). TrustProxies is "*" on their side, so the app
# derives scheme/host from X-Forwarded-*; nothing else is needed here.
youandco.online {
    import security_headers
    reverse_proxy localhost:8100
}

www.youandco.online {
    redir https://youandco.online{uri} permanent
}
