# /etc/caddy/Caddyfile on corecuity-clients (161.97.166.112) — every client site's public web front.
#
# Source of truth: elmaati repo, deploy/clients/caddy/. Never edit on the server — deploy with ./deploy.sh
# (validate on host → timestamped backup → install → reload). Brought into git 2026-09-29 from the live file.
# Basic-auth hashes live ONLY on the server in /etc/caddy/auth.caddy (imported below; never committed).
# REQUIRES Caddy >= 2.7 (trusted_proxies / client_ip_headers). The host runs Caddy from the official apt repo
# since 2026-10-09 (it had Ubuntu's 2.6.2 before, on which this file does not validate).

# Global options
{
    email admin@corecuity.com
    # Admin API moved off 127.0.0.1:2019 (2026-08-20): any local user could
    # POST /load and hijack every vhost on this box. Unix socket = caddy user only.
    admin unix//run/caddy/admin.sock

    # Real visitor IPs behind Cloudflare's proxy (2026-09-29). Only requests arriving FROM Cloudflare's own
    # ranges are trusted to name the client: Caddy then takes the visitor's IP from CF-Connecting-IP and
    # passes it on in X-Forwarded-For to WordPress, Odoo, Next.js and the logs. Anything else can't spoof it.
    # Ranges: Cloudflare API /ips (etag 38f79d050aa027e3be3865e495dcc9bc) — refresh if Cloudflare changes them.
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# Basic-auth snippets (auth_netdata, auth_paradisante_stage) — server-only file, see header.
import auth.caddy

# --- Shared security headers (ODAE-51, 2026-08-03) ------------------------
# Defined here rather than in the Next.js or WordPress config so they cover
# every host on this server, including any added later, without depending on
# a framework staying configured.
#
# HSTS max-age is deliberately 1 day, not a year. A browser honours HSTS for
# its full duration no matter what the server later says, so a long max-age
# set on a domain that turns out to be misconfigured is genuinely painful to
# undo. Raise to 31536000 once odae.ma has been stable for a week; do not add
# `preload` before that, since removal from the preload list takes months.
(security_headers) {
    header {
        Strict-Transport-Security "max-age=86400"
        # `?` = set only if absent. WordPress already sends this, and a plain
        # set appends rather than replaces on a proxied response, so the
        # backend was answering with the header twice.
        ?X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    }
}

# Storefront: nothing should ever frame a checkout that collects names, phone
# numbers and delivery addresses. frame-ancestors is the modern form and
# X-Frame-Options is kept for older browsers that ignore it.
(no_framing) {
    header {
        Content-Security-Policy "frame-ancestors none"
        X-Frame-Options "DENY"
    }
}

# Client and service routes added below — one block per domain.

monitor.corecuity.com {
    reverse_proxy localhost:19999
    import auth_netdata
}

mail.corecuity.com, mail.paradisante.ma, autoconfig.paradisante.ma, autodiscover.paradisante.ma, autoconfig.ajihost.ma, autodiscover.ajihost.ma {
    reverse_proxy https://localhost:8026 {
        # Caddy >= 2.11 rewrites Host to the upstream for https:// upstreams; SOGo then builds
        # its redirects as https://localhost:8026/... Keep the public hostname.
        header_up Host {host}
        transport http {
            tls_insecure_skip_verify
        }
    }
}

