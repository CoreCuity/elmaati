# ===== Odae — production (odae.corecuity.com / wp-odae.corecuity.com) =======

# --- Canonical, from the 2026-08-03 cutover -------------------------------

odae.ma {
    import security_headers
    import no_framing

    # Convenience shortcut to the headless WordPress backoffice.
    @admin path /admin /admin/
    redir @admin https://wp.odae.ma/wp-admin 302

    reverse_proxy localhost:8091
}

# Apex is canonical; www exists only so a typed-in www does not fail.
www.odae.ma {
    import security_headers
    redir https://odae.ma{uri} permanent
}

wp.odae.ma {
    import security_headers
    # SAMEORIGIN, not DENY: wp-admin frames its own screens (media, previews),
    # and DENY would break the backoffice the client has to work in.
    header X-Frame-Options "SAMEORIGIN"

    # XML-RPC is deliberately NOT blocked here any more. The WooCommerce iOS
    # app pings xmlrpc.php during site detection, before either login method,
    # so a 403 stopped the client's phone from ever reaching a login screen.
    #
    # The block moved into PHP instead, where it can be selective:
    # wp-content/mu-plugins/harden.php removes system.multicall — the real
    # problem, since it batched hundreds of password guesses into ONE request
    # and so bypassed any request-counting throttle — and removes pingback.*,
    # which made this box a DDoS reflector. The authenticated methods that
    # remain are covered by the same 10-per-15-min throttle as wp-login.php,
    # because XML-RPC logins run through the `authenticate` filter too.

    # Ship-with-WordPress files that state the exact core version. Blocked here
    # rather than deleted because a core update restores them.
    @wpmeta path /readme.html /license.txt /wp-config-sample.php
    respond @wpmeta 404

    reverse_proxy localhost:8090 {
        # Apache and PHP announce their exact versions on every response,
        # which is free reconnaissance. Caddy still sends its own Server header.
        header_down -X-Powered-By
        header_down -Server
    }
}

# --- Old hostnames: retired 2026-08-03, now forwarding --------------------
# 302 rather than 301, deliberately. Nothing is indexed and nothing has been
# shared on the old hostnames, so there is no SEO value in a permanent
# redirect — but a 301 is cached by browsers and would survive a rollback,
# stranding anyone who had visited during the launch window. Promote to
# `permanent` once the 48h monitoring window closes.

odae.corecuity.com {
    redir https://odae.ma{uri} 302
}

wp-odae.corecuity.com {
    redir https://wp.odae.ma{uri} 302
}

# --- Adolia Odoo 19 (migrated from contabo-deploy, 2026-08-17) ---
adolia.odoobooking.online {
    # --- SECURITY 2026-08-23: block Odoo database manager ---
    # Was publicly reachable (HTTP 200) and used to compromise the staging
    # Postgres container on 2026-08-22 (Monero miner). Defence-in-depth:
    # list_db = False is also set in odoo.conf / odoo-stage.conf.
    @dbmgr path /web/database/manager* /web/database/selector* /web/database/create* /web/database/duplicate* /web/database/drop* /web/database/backup* /web/database/restore* /web/database/change_password*
    respond @dbmgr 403
    import security_headers
    encode zstd gzip
    reverse_proxy 127.0.0.1:8094
}

adolia-stage.odoobooking.online {
    # --- SECURITY 2026-08-23: block Odoo database manager ---
    # Was publicly reachable (HTTP 200) and used to compromise the staging
    # Postgres container on 2026-08-22 (Monero miner). Defence-in-depth:
    # list_db = False is also set in odoo.conf / odoo-stage.conf.
    @dbmgr path /web/database/manager* /web/database/selector* /web/database/create* /web/database/duplicate* /web/database/drop* /web/database/backup* /web/database/restore* /web/database/change_password*
    respond @dbmgr 403
    import security_headers
    encode zstd gzip
    reverse_proxy 127.0.0.1:8096
}

